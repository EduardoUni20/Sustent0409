# Variables de ejemplo para Supabase, validación HMAC y detección por ventana deslizante.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=PEGA_AQUI_LA_CLAVE_PRIVADA_DE_SUPABASE
# Alternativa para proyectos antiguos: SUPABASE_SERVICE_ROLE_KEY

# Detección por usuario: al menos 3 transacciones válidas en 3 segundos.
WINDOW_SECONDS=3
TRANSACTION_THRESHOLD=3

# Tamaño de la ventana móvil seleccionado según la fecha de cada transacción.
WINDOW_TIME_ZONE=America/Bogota
MORNING_WINDOW_SIZE=10
AFTERNOON_WINDOW_SIZE=6
NIGHT_WINDOW_SIZE=3

# HMAC-SHA-256 verifica la integridad; comparte HASH_SECRET solo con el emisor.
HASH_ALGORITHM=hmac-sha256
HASH_ENCODING=hex
HASH_FIELDS=idTxn,user,date,value,paymentMethod
HASH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# En producción se recomienda restringirlo al dominio que llama desde un navegador.
ALLOWED_ORIGIN=*
