SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=PEGA_AQUI_LA_CLAVE_PRIVADA_DE_SUPABASE
# Alternativa para proyectos antiguos: SUPABASE_SERVICE_ROLE_KEY

# Regla de ventana deslizante
WINDOW_SECONDS=3
TRANSACTION_THRESHOLD=3

# Hash: SHA-256 de JSON.stringify({idTxn,user,date,value,paymentMethod})
HASH_ALGORITHM=sha256
HASH_ENCODING=hex
HASH_FIELDS=idTxn,user,date,value,paymentMethod
# Solo se necesita si HASH_ALGORITHM=hmac-sha256
HASH_SECRET=

# Secreto compartido para autorizar POST /api/transactions; configúralo también
# como encabezado x-api-key en Postman. No es el hash de la transacción.
INGEST_API_KEY=865d7c70be346255bd29e66f6cff1038f5a3065d82a8770fa63ab70f44ecb572
# En producción se recomienda restringirlo al dominio que llama desde un navegador.
ALLOWED_ORIGIN=*
